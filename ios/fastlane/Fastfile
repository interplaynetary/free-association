default_platform(:ios)

platform :ios do
  desc "Build iOS App"
  lane :build do
    setup_xcode(
      vscode: true # Setup for VS Code environment optimization
    )

    # 1. Handle Signing
    # 'match' is the best way. It syncs certificates from a private git repo.
    # If the user hasn't set up match yet, this step will fail, so we wrap it or assume they will.
    # For now, we'll try read_only mode so it doesn't try to create new certs on CI.
    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore", 
        readonly: true,
        git_url: ENV["MATCH_GIT_URL"],
        # clone_branch_automatically: true
      )
    else
      UI.important("MATCH_GIT_URL not set. Skipping 'match'. Assuming manual signing or certs already installed.")
    end

    # 2. Build the App
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "../output",
      output_name: "App.ipa"
    )
  end
end
