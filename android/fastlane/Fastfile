default_platform(:android)

platform :android do
  desc "Build Android App Bundle"
  lane :build do
    # Check if keystore environment variables are set
    unless ENV["RELEASE_KEYSTORE"] && ENV["RELEASE_KEYSTORE_PASSWORD"]
      UI.error("Keystore environment variables not set. Please set RELEASE_KEYSTORE and RELEASE_KEYSTORE_PASSWORD.")
    end

    # Decode keystore from environment variable
    # We assume the workflow decodes the BASE64 string to a file, e.g. 'release.decrypted.jks'
    # But strictly speaking, fastlane offers 'gradle' action.
    # We will let the GitHub Action handle the decoding part to keep secrets logic in one place,
    # OR we can do it here. Let's rely on the Action to decode it to a known path for simplicity,
    # or handle it here if we want to be fully 'fastlane'.
    
    # Let's assume the Action decodes the keystore to "./android/release.jks" before running this lane.
    
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => "release.decrypted.jks",
        "android.injected.signing.store.password" => ENV["RELEASE_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => "release",
        "android.injected.signing.key.password" => ENV["RELEASE_KEYSTORE_PASSWORD"],
      }
    )
    
    # Copy artifacts to output directory relative to root
    sh "mkdir -p ../output"
    sh "cp app/build/outputs/bundle/release/app-release.aab ../output/app-release.aab"
  end
end
